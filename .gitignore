# ==============================================================================
# EVENTVIET - GITIGNORE CONFIGURATION
# ==============================================================================

# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Python & Pytest
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.venv/
env/
venv/
ENV/
*.egg-info/

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.pem

# Data, SQLite & Qdrant Vector Stores
data/*.db
data/*.sqlite
data/*.sqlite3
data/qdrant/
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/qdrant/
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# Logs & OS artifacts
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
