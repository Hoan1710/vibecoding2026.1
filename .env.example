# ==============================================================================
# EVENTVIET - EXAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND NEXT.JS CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAG_BACKEND_URL=http://127.0.0.1:8000
AI_MODE=real
AI_MODEL=chib/gemini-3.8-flash
AI_BASE_URL=https://api.vilao.ai/v1
ANTHROPIC_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
# 2. BACKEND RAG FASTAPI CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=dev
ADMIN_TOKEN=eventviet-admin-secret-token-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/hour
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_QUERY_CHARS=500
HISTORY_TURNS=4

# LLM Generation
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here
LLM_MODEL=chib/gemini-3.8-flash
LLM_BASE_URL=https://api.vilao.ai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_S=20

# Embedding (Local Multilingual MiniLM L12 v2 - 384 dim - Offline/No API key needed)
EMBED_PROVIDER=local_st
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
EMBED_BATCH=32

# Rerank
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=15

# Vector Store (Qdrant Local)
VECTOR_BACKEND=qdrant_local
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=kb_chunks

# Database & Cache (SQLite)
DB_URL=sqlite:///./data/app.db
CACHE_BACKEND=memory
EXACT_CACHE_TTL_S=21600
SEMANTIC_CACHE_THRESHOLD=0.96

# Retrieval & Hybrid Ranking (Dense + BM25s + RRF)
TOPK_DENSE=20
TOPK_BM25=20
RRF_K=60
CONTEXT_TOPK=5
DOC_TYPE_BOOST=0.15

# Gating Thresholds
GATE_ANSWER_MIN=0.30
GATE_CAUTION_MIN=0.10
GATE_MARGIN_MIN=0.03

# Ingestion Pipeline
ENRICH=false
ENRICH_CONCURRENCY=4
CHUNK_TARGET_SYLLABLES=350
CHUNK_MAX_SYLLABLES=550
CHUNK_MIN_SYLLABLES=40
CHUNK_OVERLAP_RATIO=0.12
SEED_ON_EMPTY=true

# Logging & Masking
LOG_LEVEL=INFO
LOG_PII_MASK=true
