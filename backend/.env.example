APP_ENV=dev
ADMIN_TOKEN=eventviet-admin-secret-token-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/hour
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_QUERY_CHARS=500
HISTORY_TURNS=4

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=sk-cab44d8a1592f10c2abaf5c77a87f7845cef7e0aed056b8bc9ffe260e5f202f7
LLM_MODEL=chib/gemini-3.8-flash
LLM_BASE_URL=https://api.vilao.ai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_S=20

# Embedding
EMBED_PROVIDER=fake
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_BATCH=64

# Rerank
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=15

# Vector store
VECTOR_BACKEND=qdrant_local
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=kb_chunks

# DB / cache
DB_URL=sqlite:///./data/app.db
CACHE_BACKEND=memory
EXACT_CACHE_TTL_S=21600
SEMANTIC_CACHE_THRESHOLD=0.96

# Retrieval
TOPK_DENSE=20
TOPK_BM25=20
RRF_K=60
CONTEXT_TOPK=5
DOC_TYPE_BOOST=0.15

# Gating
GATE_ANSWER_MIN=0.45
GATE_CAUTION_MIN=0.25
GATE_MARGIN_MIN=0.03

# Ingestion
ENRICH=false
ENRICH_CONCURRENCY=4
CHUNK_TARGET_SYLLABLES=350
CHUNK_MAX_SYLLABLES=550
CHUNK_MIN_SYLLABLES=40
CHUNK_OVERLAP_RATIO=0.12
SEED_ON_EMPTY=true

LOG_LEVEL=INFO
LOG_PII_MASK=true
