# API AI - lấy từ provider
ANTHROPIC_API_KEY=your-api-key-here

# Model AI (mặc định: claude-haiku-4-5)
AI_MODEL=chib/gemini-3.8-flash

# Base URL tùy chỉnh (nếu dùng provider khác)
